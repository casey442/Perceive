<script>
  // six tiles: anchor the hover pop-over inward on each row's edge columns
  const grid = document.getElementById('sixGrid');
  if (grid) {
    const tiles = Array.from(grid.querySelectorAll<HTMLElement>('.v4d-tile'));
    const layout = () => {
      tiles.forEach((t) => t.classList.remove('edge-l', 'edge-r'));
      const rows = new Map<number, HTMLElement[]>();
      tiles.forEach((t) => {
        const key = t.offsetTop;
        (rows.get(key) || rows.set(key, []).get(key)!).push(t);
      });
      rows.forEach((row) => {
        if (row.length < 2) return;
        row[0].classList.add('edge-l');
        row[row.length - 1].classList.add('edge-r');
      });
    };
    layout();
    window.addEventListener('resize', layout);
  }

  // Calendly-style demo scheduler (September 2026; deterministic for the study)
  const cal = document.getElementById('v4cal');
  if (cal) {
    const gridEl = document.getElementById('calGrid')!;
    const slotsEl = document.getElementById('calSlots')!;
    const headEl = document.getElementById('calTimesHead')!;
    const sumEl = document.getElementById('calSum')!;
    const confirmEl = document.getElementById('calConfirm') as HTMLButtonElement;
    const DOW = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    const SLOTS = ['9:00 am', '9:30 am', '10:00 am', '10:30 am', '1:00 pm', '1:30 pm', '3:00 pm', '3:30 pm'];
    const YEAR = 2026, M = 8, TODAY = 6; // Sep 2026, "today" = the 6th
    const firstDow = new Date(YEAR, M, 1).getDay();
    const days = new Date(YEAR, M + 1, 0).getDate();
    let selDay: number | null = null, selTime: string | null = null;

    const state = () => {
      const ready = selDay && selTime;
      confirmEl.disabled = !ready;
      sumEl.textContent = ready
        ? `${DOW[new Date(YEAR, M, selDay!).getDay()]}, ${MON[M]} ${selDay} · ${selTime}`
        : 'Pick a day and time to continue';
    };
    const renderSlots = () => {
      slotsEl.innerHTML = '';
      SLOTS.forEach((t) => {
        const b = document.createElement('button');
        b.className = 'slot'; b.type = 'button'; b.textContent = t;
        b.addEventListener('click', () => {
          selTime = t;
          slotsEl.querySelectorAll('.slot').forEach((s) => s.classList.remove('sel'));
          b.classList.add('sel'); state();
        });
        slotsEl.appendChild(b);
      });
    };
    for (let i = 0; i < firstDow; i++) {
      const e = document.createElement('span'); e.className = 'day empty'; gridEl.appendChild(e);
    }
    for (let d = 1; d <= days; d++) {
      const dow = new Date(YEAR, M, d).getDay();
      const b = document.createElement('button');
      b.className = 'day'; b.type = 'button'; b.textContent = String(d);
      const open = d > TODAY && dow !== 0 && dow !== 6;
      if (!open) { b.disabled = true; }
      else {
        b.classList.add('avail');
        b.addEventListener('click', () => {
          selDay = d; selTime = null;
          gridEl.querySelectorAll('.day').forEach((x) => x.classList.remove('sel'));
          b.classList.add('sel');
          headEl.textContent = `${DOW[dow]}, ${MON[M]} ${d}`;
          renderSlots(); state();
        });
      }
      gridEl.appendChild(b);
    }
    confirmEl.addEventListener('click', () => {
      if (confirmEl.disabled) return;
      confirmEl.textContent = 'Requested ✓';
      sumEl.textContent = 'We would email a confirmation here.';
    });
    state();
  }
</script>


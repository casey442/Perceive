  .v4d-marquee:hover .v4d-marquee-row { animation-play-state: paused; }
  @keyframes v4dScrollLeft { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @keyframes v4dScrollRight { from { transform: translateX(-50%); } to { transform: translateX(0); } }
  .v4d-tag { display: inline-flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: 12.5px; color: var(--ink); background: var(--card); border: 1px solid var(--line2); border-radius: 100px; padding: 8px 16px; }

---
import Base from '../layouts/Base.astro';
import '../styles/lab.css';
import LabBar from '../components/LabBar.astro';

// The Lab hub: a single page linking to every design and copy exploration.
const items = [
  {
    num: '00', name: 'Feedback V1', tag: 'Design',
    href: '/lab/feedback-v1/', preview: '/lab/feedback-v1/',
    desc: 'Consolidation study — the winning direction: Function Health warm palette, Luxe headline-right hero, Motion hover/tap pop-up features, marquee.',
  },
  {
    num: '00', name: 'Feedback V2 · Hamptons', tag: 'Design',
    href: '/lab/feedback-v2/', preview: '/lab/feedback-v2/',
    desc: 'The V1 layout in a light coastal palette — ivory ground, greige cards, charcoal text, navy brand moments, sage accent.',
  },
  {
    num: '00', name: 'Feedback V3 · Live Product', tag: 'Design',
    href: '/lab/feedback-v3/', preview: '/lab/feedback-v3/',
    desc: 'The pop-ups fused into one live app, framed in the arch as a sneak peek (scroll right to explore). Light (V2) / dark (V1) toggle.',
  },
  {
    num: '00', name: 'Contrarian', tag: 'Design',
    href: '/lab/contrarian/', preview: '/lab/contrarian/',
    desc: 'The inverse of a SaaS page: a founder\'s letter in Fraunces + Newsreader (V3 palette, light/dark). Exact prices, who it is not for, competitors conceded, a live 0-districts counter, one small CTA.',
  },
  {
    num: '01', name: 'Home study', tag: 'Design',
    href: '/lab/home-study/', preview: '/lab/home-study/',
    desc: 'Mono study — silver hero field, alternating black bands, Bauhaus geometry, barcode spine.',
  },
  {
    num: '02', name: 'Theme review', tag: 'Design',
    href: '/lab/themes/', preview: '/lab/theme/2/',
    desc: 'Nine palette + font directions on the same homepage, click to compare.',
  },
  {
    num: '03', name: 'Function Health layout', tag: 'Design',
    href: '/lab/function-health/', preview: '/lab/function-health/',
    desc: 'A full-layout study mirroring Function Health: dark hero, three boxes, back-and-forth scroll.',
  },
  {
    num: '04', name: 'Luxe', tag: 'Design',
    href: '/lab/luxe/', preview: '/lab/luxe/',
    desc: 'A premium, cinematic variation: thin Playfair, tracked labels, a dark hero, and real photography.',
  },
  {
    num: '05', name: 'Motion', tag: 'Design',
    href: '/lab/motion/', preview: '/lab/motion/',
    desc: 'A short, modern page whose feature boxes play an animated preview on hover or tap (green).',
  },
  {
    num: '06', name: 'Motion B&W', tag: 'Design',
    href: '/lab/motion-bw/', preview: '/lab/motion-bw/',
    desc: 'The same hover-to-animate page in a monochrome black-and-white treatment.',
  },
  {
    num: '07', name: 'Crisp', tag: 'Design',
    href: '/lab/crisp/', preview: '/lab/crisp/',
    desc: 'A clean, premium productivity-app homepage: product switcher, app mockups on gradient panels.',
  },
  {
    num: '08', name: 'Headlines', tag: 'Copy',
    href: '/lab/headlines/', preview: '/lab/headlines/',
    desc: 'Six hero headline options, rendered side by side.',
  },
  {
    num: '09', name: 'How it works · Search-led', tag: 'Copy',
    href: '/lab/how-it-works-search/', preview: '/lab/how-it-works-search/',
    desc: 'Product page led by search, with translated + cited summaries.',
  },
  {
    num: '10', name: 'How it works · Workflow-led', tag: 'Copy',
    href: '/lab/how-it-works-workflow/', preview: '/lab/how-it-works-workflow/',
    desc: 'Product page led by the draft → review → publish workflow.',
  },
];
---
<Base title="BoardPlanner — the Lab">
  <div class="lab">
    <LabBar active="index" />

    <header class="hub-hero">
      <div class="wrap">
        <span class="hint">Internal review</span>
        <h1>The Lab.</h1>
        <p>Every design and copy exploration in one place. Nothing here is live — the approved homepage sits at <a href="/">/</a>. Refer to each by number when you leave feedback.</p>
      </div>
    </header>

    <div class="wrap">
      <div class="hub-grid">
        {items.map((it) => (
          <a class="hcard" href={it.href}>
            <div class="frame">
              <iframe src={it.preview} title={it.name} loading="lazy" scrolling="no" tabindex="-1"></iframe>
            </div>
            <div class="hmeta">
              <div class="hrow">
                <span class="hnum">{it.num}</span>
                <span class="hname">{it.name}</span>
                <span class={`htag ${it.tag === 'Copy' ? 'copy' : 'design'}`}>{it.tag}</span>
              </div>
              <div class="hdesc">{it.desc}</div>
            </div>
          </a>
        ))}
      </div>

      <section class="hub-ref">
        <span class="ref-label">Reference</span>
        <ul>
          <li><a href="/">Approved homepage</a><span>the live source of truth (/)</span></li>
          <li><a href="/lab/themes/">All six theme pages</a><span>via the theme review gallery</span></li>
          <li><span class="doc">copy/messaging.md</span><span>positioning + VBF + feature copy (in the repo)</span></li>
        </ul>
      </section>
    </div>

    <footer class="hub-foot">
      <div class="wrap">
        <span>© 2026 BoardPlanner</span>
        <span class="adjourned-lite">Meeting adjourned.</span>
      </div>
    </footer>
  </div>
</Base>

<style>
  .hub-hero { text-align: center; padding: 64px 0 20px; }
  .hub-hero .hint { font-family: var(--serif-text); font-size: 11.5px; font-weight: 500; letter-spacing: .2em; text-transform: uppercase; color: var(--label); }
  .hub-hero h1 { font-family: var(--serif-display); font-size: clamp(46px, 6vw, 76px); font-weight: 520; letter-spacing: -0.02em; margin: 14px 0 16px; }
  .hub-hero p { font-family: var(--serif-text); font-size: 17px; line-height: 1.6; color: var(--muted); max-width: 60ch; margin: 0 auto; }
  .hub-hero p a { color: var(--ink); }

  .hub-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; padding: 24px 0 40px; }
  .hcard { display: block; text-decoration: none; color: var(--ink); border: 1px solid var(--line2); border-radius: 8px; overflow: hidden; background: var(--card); transition: transform .25s cubic-bezier(.2,.6,.2,1), box-shadow .25s cubic-bezier(.2,.6,.2,1); }
  .hcard:hover { transform: translateY(-4px); box-shadow: 0 30px 60px -30px rgba(0,0,0,.32); }
  .frame { position: relative; height: 260px; overflow: hidden; border-bottom: 1px solid var(--line); background: var(--silver); }
  .frame iframe { position: absolute; top: 0; left: 0; width: 1400px; height: 1120px; border: 0; transform: scale(0.25); transform-origin: top left; pointer-events: none; }

  .hmeta { padding: 18px 20px 20px; font-family: var(--serif-text); }
  .hrow { display: flex; align-items: baseline; gap: 12px; }
  .hnum { font-family: var(--serif-display); font-style: italic; font-weight: 300; font-size: 22px; color: var(--label); }
  .hname { font-family: var(--serif-display); font-size: 20px; font-weight: 560; letter-spacing: -0.01em; }
  .htag { margin-left: auto; font-size: 10px; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; border: 1px solid var(--line2); border-radius: 100px; padding: 3px 10px; color: var(--label); }
  .htag.design { color: var(--ink); border-color: var(--hair); }
  .htag.copy { color: var(--muted); }
  .hdesc { font-size: 14.5px; line-height: 1.5; color: var(--muted); margin-top: 9px; }

  .hub-ref { border-top: 1px solid var(--line); padding: 32px 0 8px; margin-top: 12px; }
  .ref-label { font-size: 11px; font-weight: 500; letter-spacing: .2em; text-transform: uppercase; color: var(--label); }
  .hub-ref ul { list-style: none; margin: 16px 0 0; }
  .hub-ref li { display: flex; align-items: baseline; gap: 14px; padding: 12px 2px; border-top: 1px solid var(--line); font-family: var(--serif-text); }
  .hub-ref li:first-child { border-top: none; }
  .hub-ref li a { font-family: var(--serif-display); font-size: 18px; color: var(--ink); text-decoration: none; border-bottom: 1px solid transparent; }
  .hub-ref li a:hover { border-color: var(--ink); }
  .hub-ref li .doc { font-family: var(--serif-display); font-size: 18px; color: var(--muted); }
  .hub-ref li span:last-child { font-size: 14px; color: var(--label); font-style: italic; }

  .hub-foot { border-top: 1px solid var(--line); padding: 26px 0; margin-top: 40px; }
  .hub-foot .wrap { display: flex; justify-content: space-between; font-family: var(--serif-text); font-size: 13px; color: var(--muted); }
  .adjourned-lite { font-family: var(--serif-display); font-style: italic; color: var(--label); }

  @media (max-width: 980px) { .hub-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 620px) { .hub-grid { grid-template-columns: 1fr; } }
</style>

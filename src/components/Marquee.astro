---
// OPEN ITEM: mock content — swap for real, anonymized district items at launch.
// Lead noun is bold; the rest is the italic detail.
const items = [
  { lead: 'superintendent contract', detail: 'Nov 2019' },
  { lead: 'bus routes', detail: 'redrawn 2023' },
  { lead: 'boundary study', detail: 'tabled, revisited, adopted' },
  { lead: 'substitute pay scale', detail: 'amended' },
  { lead: 'consent agenda 8.B', detail: 'pulled for discussion' },
  { lead: 'FFA trip', detail: 'approved 7–0' },
  { lead: 'roof bid, Lincoln Elementary', detail: 'awarded' },
  { lead: 'calendar adoption', detail: 'first reading' },
  { lead: 'milk vendor', detail: 'renewed' },
];
---
<div class="marquee-band" id="band">
  <span class="band-label">On the record</span>
  <div class="marquee-clip">
    <div class="marquee-inner" aria-hidden="true">
      {items.map((it) => <span class="q"><b>{it.lead}</b> · {it.detail}</span>)}
      {items.map((it) => <span class="q"><b>{it.lead}</b> · {it.detail}</span>)}
    </div>
  </div>
  <button class="pause-btn" id="marquee-pause" aria-label="Pause scrolling">❚❚</button>
</div>

<script>
  const band = document.getElementById('band');
  const btn = document.getElementById('marquee-pause');
  btn?.addEventListener('click', () => {
    const paused = band?.classList.toggle('paused');
    if (btn) btn.textContent = paused ? '▶' : '❚❚';
  });
</script>

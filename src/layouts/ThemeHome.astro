---
import Base from './Base.astro';
import { themes } from '../data/themes.js';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Boxes from '../components/Boxes.astro';
import Stakes from '../components/Stakes.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';

const { theme } = Astro.props;
const v = theme.vars;

const ti = themes.findIndex((t) => t.num === theme.num);
const prevT = themes[(ti - 1 + themes.length) % themes.length];
const nextT = themes[(ti + 1) % themes.length];

// Variables go INLINE on the .themed wrapper so they win by inheritance,
// independent of stylesheet order. Per-theme tweaks are scoped under .themed so
// they out-specify global.css.
const inlineVars = [
  `--paper:${v.paper}`, `--silver:${v.silver}`, `--silver2:${v.silver2}`, `--card:${v.card}`,
  `--ink:${v.ink}`, `--muted:${v.muted}`, `--label:${v.label}`,
  `--line:${v.line}`, `--line2:${v.line2}`, `--hair:${v.hair}`,
  `--serif-display:${theme.fonts.display}`, `--serif-text:${theme.fonts.text}`,
].join(';');

function scope(css) {
  if (!css) return '';
  return css.replace(/([^{}]+)\{([^{}]*)\}/g, (_m, sel, body) => {
    const scoped = sel.split(',').map((s) => `.themed ${s.trim()}`).join(', ');
    return `${scoped}{${body}}`;
  });
}

const css = `
html{background:${v.paper};}
.themed{background:var(--paper);min-height:100vh;font-family:var(--serif-text);color:var(--ink);}
${scope(theme.extraCss)}
.theme-nav{position:fixed;left:50%;bottom:18px;top:auto;transform:translateX(-50%);z-index:300;display:flex;align-items:center;gap:3px;
  background:rgba(17,17,17,.9);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);
  border:1px solid rgba(255,255,255,.14);border-radius:100px;padding:5px;
  box-shadow:0 14px 36px -14px rgba(0,0,0,.55);
  font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;max-width:calc(100vw - 32px);}
.theme-nav a{color:#E8E8E8;text-decoration:none;font-size:12.5px;padding:7px 13px;border-radius:100px;white-space:nowrap;transition:background .15s ease,color .15s ease;}
.theme-nav a:hover{background:rgba(255,255,255,.1);color:#fff}
.theme-nav .tn-mid{color:#A6A6A6;font-size:11px;letter-spacing:.06em;text-transform:uppercase;}
.theme-nav b{font-weight:600;color:#fff;font-style:normal}
`;
---
<Base title={`BoardPlanner — ${theme.name} (theme 0${theme.num})`}>
  <Fragment slot="head">
    {theme.googleHref && <link rel="preconnect" href="https://fonts.googleapis.com" />}
    {theme.googleHref && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />}
    {theme.googleHref && <link rel="stylesheet" href={theme.googleHref} />}
    <style set:html={css}></style>
  </Fragment>

  <div class="themed" style={inlineVars}>
    <nav class="theme-nav" data-prev={`/lab/theme/${prevT.num}/`} data-next={`/lab/theme/${nextT.num}/`} aria-label="Theme switcher">
      <a href={`/lab/theme/${prevT.num}/`} title="Previous theme (←)">‹ <b>0{prevT.num}</b> {prevT.name}</a>
      <a class="tn-mid" href="/lab/themes/">{theme.num} / {themes.length} · all</a>
      <a href={`/lab/theme/${nextT.num}/`} title="Next theme (→)">{nextT.name} <b>0{nextT.num}</b> ›</a>
    </nav>
    <Nav />
    <Hero headline={'Keep records.<br>In <em>record</em> time.'} />
    <Marquee />
    <Boxes />
    <Stakes />
    <FinalCta />
    <Footer />
  </div>
</Base>

<script>
  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }),
    { threshold: 0.12 }
  );
  document.querySelectorAll<HTMLElement>('.reveal').forEach((el, i) => {
    el.style.transitionDelay = (i % 4) * 70 + 'ms';
    io.observe(el);
  });

  // Left/Right arrow keys flip between themes.
  const tnav = document.querySelector('.theme-nav');
  if (tnav) {
    document.addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement | null;
      if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      if (e.key === 'ArrowLeft') { const h = tnav.getAttribute('data-prev'); if (h) window.location.href = h; }
      if (e.key === 'ArrowRight') { const h = tnav.getAttribute('data-next'); if (h) window.location.href = h; }
    });
  }
</script>
